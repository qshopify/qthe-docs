<button type="button" class="search-trigger" data-search-open aria-label="Search docs">
  <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="9" r="6.5" /><path d="M18 18l-4.3-4.3" /></svg>
  <span class="st-label">Search</span>
  <kbd class="st-kbd">⌘K</kbd>
</button>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<dialog id="searchDialog" class="search-dialog" aria-label="Search docs">
  <button type="button" id="searchClose" class="sd-close" aria-label="Close search">Esc</button>
  <div id="pfContainer" class="pf-container"></div>
</dialog>

<style>
  .search-trigger { @apply hidden md:flex items-center gap-2 text-sm text-ink-2 bg-paper-2 border border-line rounded-full px-3.5 py-1.5 transition; }
  .search-trigger:hover { @apply text-ink border-line-2; }
  .st-kbd { @apply font-mono text-[11px] text-faint border border-line-2 rounded px-1.5 py-0.5 ml-1; }

  .search-dialog { position:relative; width:min(600px, calc(100vw - 32px)); min-height:240px; max-height:min(70vh, 560px);
    padding:16px; border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow-float); background:var(--paper); overflow:hidden; }
  .search-dialog::backdrop { background:rgba(30,30,26,.4); backdrop-filter:blur(2px); }
  .sd-close { position:absolute; top:14px; right:14px; z-index:2; font-family:var(--mono); font-size:11px; color:var(--muted);
    border:1px solid var(--line-2); border-radius:6px; padding:3px 7px; background:var(--paper); }
  .sd-empty { padding:28px 16px; text-align:center; color:var(--muted); font-size:14px; }

  .pf-container { max-height:min(70vh, 560px); overflow-y:auto; }
  .pf-container {
    --pagefind-ui-scale: 0.92;
    --pagefind-ui-primary: var(--accent-ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--paper-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 10px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 1;
    --pagefind-ui-font: inherit;
  }
  .pf-container :global(.pagefind-ui__search-input) { padding-right:40px; }
  .pf-container :global(.pagefind-ui__result-link) { color:var(--accent-ink); }
</style>

<script is:inline>
  // is:inline runs synchronously at parse time, before later-in-document elements
  // (like the mobile menu's search button) exist — wait for full parse first.
  // Guard against DOMContentLoaded having already fired by the time this runs.
  function initSearch() {
    const triggers = Array.from(document.querySelectorAll('[data-search-open]'));
    const dialog = document.getElementById('searchDialog');
    const closeBtn = document.getElementById('searchClose');
    const container = document.getElementById('pfContainer');
    if (!triggers.length || !dialog || !closeBtn || !container) return;

    let pfui = null;
    let failed = false;

    const ensurePfui = async () => {
      if (pfui || failed) return pfui;
      try {
        // Only exists in the built site, generated by `pagefind --site dist`; absent in dev.
        await import(/* @vite-ignore */ '/pagefind/pagefind-ui.js');
        pfui = new window.PagefindUI({
          element: '#pfContainer',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          bodyClass: '',
        });
      } catch {
        failed = true;
        container.innerHTML = '<div class="sd-empty">Search isn\'t available in local dev — it runs after a production build.</div>';
      }
      return pfui;
    };

    const open = async () => {
      if (!pfui && !failed) container.innerHTML = '<div class="sd-empty">Loading search…</div>';
      dialog.showModal();
      await ensurePfui();
      container.querySelector('input')?.focus();
    };
    const close = () => dialog.close();
    dialog.addEventListener('close', () => {
      document.querySelector('details.mmenu')?.removeAttribute('open');
    });

    triggers.forEach((t) => t.addEventListener('click', open));
    closeBtn.addEventListener('click', close);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        dialog.open ? close() : open();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>
