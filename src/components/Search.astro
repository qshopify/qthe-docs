<button type="button" class="search-trigger" data-search-open aria-label="Search docs">
  <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="9" r="6.5" /><path d="M18 18l-4.3-4.3" /></svg>
  <span class="st-label">Search</span>
  <kbd class="st-kbd">⌘K</kbd>
</button>

<dialog id="searchDialog" class="search-dialog" aria-label="Search docs">
  <div class="sd-bar">
    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="9" r="6.5" /><path d="M18 18l-4.3-4.3" /></svg>
    <input id="searchInput" type="text" placeholder="Search docs and FAQ…" autocomplete="off" spellcheck="false" aria-label="Search query" />
    <div id="searchSpinner" class="sd-spinner" hidden aria-hidden="true"></div>
    <button type="button" id="searchClose" class="sd-close" aria-label="Close search">Esc</button>
  </div>
  <div id="searchResults" class="sd-results" aria-live="polite"></div>
  <div id="searchFoot" class="sd-foot" hidden>
    <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
    <span><kbd>↵</kbd> Open</span>
    <span><kbd>Esc</kbd> Close</span>
  </div>
</dialog>

<style>
  .search-trigger { @apply hidden md:flex items-center gap-2 text-sm text-ink-2 bg-paper-2 border border-line rounded-full px-3.5 py-1.5 transition; }
  .search-trigger:hover { @apply text-ink border-line-2; }
  .st-kbd { @apply font-mono text-[11px] text-faint border border-line-2 rounded px-1.5 py-0.5 ml-1; }

  .search-dialog { width:min(600px, calc(100vw - 32px)); height:min(70vh, 560px); display:flex; flex-direction:column;
    padding:0; border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow-float); background:var(--paper); color:var(--ink); overflow:hidden; }
  .search-dialog::backdrop { background:rgba(30,30,26,.4); backdrop-filter:blur(2px); }
  .search-dialog[open] { animation:sd-in .14s var(--ease, ease-out); }
  @keyframes sd-in { from { opacity:0; transform:translateY(-6px) scale(.98); } to { opacity:1; transform:none; } }

  .sd-bar { display:flex; align-items:center; gap:10px; padding:14px 16px; border-bottom:1px solid var(--line); color:var(--muted); flex:none; }
  .sd-bar input { flex:1; border:0; outline:0; background:transparent; font-size:15px; color:var(--ink); }
  .sd-bar input::placeholder { color:var(--faint); }
  .sd-close { font-family:var(--mono); font-size:11px; color:var(--muted); border:1px solid var(--line-2); border-radius:6px; padding:3px 7px; flex:none; }
  .sd-spinner { flex:none; width:14px; height:14px; border-radius:50%; border:2px solid var(--line-2); border-top-color:var(--accent); animation:sd-spin .6s linear infinite; }
  @keyframes sd-spin { to { transform:rotate(360deg); } }

  .sd-results { flex:1; min-height:0; overflow-y:auto; padding:8px; display:flex; flex-direction:column; gap:12px; }
  .sd-empty, .sd-hint { padding:28px 16px; text-align:center; color:var(--faint); font-size:14px; }

  .sd-group { display:flex; flex-direction:column; gap:4px; }
  .sd-group-t { font-family:var(--mono); font-size:11px; letter-spacing:.07em; text-transform:uppercase; color:var(--faint); padding:0 4px; }

  .sd-item { display:block; padding:9px 12px; border-radius:10px; text-decoration:none; border:1px solid var(--line); background:var(--paper); transition:background .12s, border-color .12s; }
  .sd-item:hover, .sd-item:focus-visible { background:var(--accent-soft); border-color:var(--accent-line); outline:none; }
  .sd-item .sd-title { font-size:14.5px; font-weight:600; color:var(--accent-ink); margin-bottom:3px; display:flex; align-items:center; gap:6px; }
  .sd-item .sd-title::after { content:'→'; opacity:0; transition:opacity .12s, transform .12s; transform:translateX(-3px); }
  .sd-item:hover .sd-title::after, .sd-item:focus-visible .sd-title::after { opacity:1; transform:translateX(0); }
  .sd-item .sd-excerpt { font-size:13px; color:var(--ink-2); line-height:1.5;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .sd-item .sd-excerpt mark { background:var(--accent-soft); color:var(--accent-ink); border-radius:3px; padding:0 1px; font-weight:600; }
  .sd-item:hover .sd-excerpt mark, .sd-item:focus-visible .sd-excerpt mark { background:#fff; }

  .sd-foot { flex:none; display:flex; gap:16px; padding:9px 16px; border-top:1px solid var(--line); background:var(--paper-2); }
  .sd-foot span { display:flex; align-items:center; gap:5px; font-size:12px; color:var(--muted); }
  .sd-foot kbd { font-family:var(--mono); font-size:10.5px; color:var(--ink-2); border:1px solid var(--line-2); border-radius:4px; padding:1px 5px; background:var(--paper); }
</style>

<script>
  type SubResult = { title: string; url: string; excerpt: string };
  type PagefindResult = { url: string; meta: { title?: string }; excerpt: string; sub_results?: SubResult[] };
  type PagefindModule = {
    init: () => Promise<void>;
    search: (term: string) => Promise<{ results: { data: () => Promise<PagefindResult> }[] }>;
  };

  const triggers = Array.from(document.querySelectorAll('[data-search-open]')) as HTMLButtonElement[];
  const dialog = document.getElementById('searchDialog') as HTMLDialogElement | null;
  const input = document.getElementById('searchInput') as HTMLInputElement | null;
  const closeBtn = document.getElementById('searchClose') as HTMLButtonElement | null;
  const resultsEl = document.getElementById('searchResults') as HTMLDivElement | null;
  const foot = document.getElementById('searchFoot') as HTMLDivElement | null;
  const spinner = document.getElementById('searchSpinner') as HTMLDivElement | null;
  if (!triggers.length || !dialog || !input || !closeBtn || !resultsEl || !foot || !spinner) {
    // Elements missing: nothing to wire up.
  } else {
    const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const HINT = '<div class="sd-hint">Type at least 2 characters to search the docs and FAQ.</div>';

    let pagefind: PagefindModule | null = null;
    let loadError = false;

    const ensurePagefind = async () => {
      if (pagefind || loadError) return pagefind;
      try {
        // @ts-ignore — only exists in the built site, generated by `pagefind --site dist`.
        pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
        await pagefind!.init();
      } catch {
        loadError = true;
      }
      return pagefind;
    };

    const render = (items: PagefindResult[]) => {
      const html = items
        .map((r) => {
          const subs = r.sub_results && r.sub_results.length ? r.sub_results.slice(0, 3) : [{ title: r.meta.title ?? r.url, url: r.url, excerpt: r.excerpt }];
          const rows = subs
            .map((s) => `<a class="sd-item" href="${s.url}"><div class="sd-title">${s.title}</div><div class="sd-excerpt">${s.excerpt}</div></a>`)
            .join('');
          // Only show the page-level label when it adds information beyond the single row's own title.
          const showGroupLabel = subs.length > 1 || subs[0].title !== (r.meta.title ?? r.url);
          const label = showGroupLabel ? `<div class="sd-group-t">${escapeHtml(r.meta.title ?? r.url)}</div>` : '';
          return `<div class="sd-group">${label}${rows}</div>`;
        })
        .join('');
      resultsEl!.innerHTML = html;
      foot!.hidden = false;
    };

    const open = async () => {
      document.querySelector('details.mmenu')?.removeAttribute('open');
      dialog!.showModal();
      input!.value = '';
      resultsEl!.innerHTML = HINT;
      foot!.hidden = true;
      input!.focus();
      await ensurePagefind();
      if (loadError) {
        resultsEl!.innerHTML = '<div class="sd-empty">Search isn\'t available in local dev — it runs after a production build.</div>';
      }
    };
    const close = () => dialog!.close();

    triggers.forEach((t) => t.addEventListener('click', open));
    closeBtn.addEventListener('click', close);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
    dialog.addEventListener('close', () => { spinner!.hidden = true; });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        dialog!.open ? close() : open();
      }
    });

    let debounceId: ReturnType<typeof setTimeout>;
    let requestId = 0;
    input.addEventListener('input', () => {
      clearTimeout(debounceId);
      const term = input!.value.trim();
      requestId += 1;
      const myRequest = requestId;
      if (!term) { resultsEl!.innerHTML = HINT; foot!.hidden = true; spinner!.hidden = true; return; }
      if (term.length < 2) { resultsEl!.innerHTML = HINT; foot!.hidden = true; spinner!.hidden = true; return; }
      spinner!.hidden = false;
      debounceId = setTimeout(async () => {
        const pf = await ensurePagefind();
        if (myRequest !== requestId) return; // superseded by a newer keystroke
        if (!pf) { spinner!.hidden = true; return; }
        const search = await pf.search(term);
        if (myRequest !== requestId) return;
        spinner!.hidden = true;
        if (!search.results.length) {
          resultsEl!.innerHTML = `<div class="sd-empty">No results for “${escapeHtml(term)}”.</div>`;
          foot!.hidden = true;
          return;
        }
        const items = await Promise.all(search.results.slice(0, 7).map((r) => r.data()));
        if (myRequest !== requestId) return;
        render(items);
      }, 150);
    });

    input.addEventListener('keydown', (e) => {
      const links = Array.from(resultsEl!.querySelectorAll('a.sd-item')) as HTMLAnchorElement[];
      if (e.key === 'Enter' && document.activeElement === input && links[0]) {
        e.preventDefault();
        links[0].click();
        return;
      }
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      if (!links.length) return;
      e.preventDefault();
      const idx = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = e.key === 'ArrowDown' ? Math.min(idx + 1, links.length - 1) : idx - 1;
      (next < 0 ? input : links[next])!.focus();
    });
    resultsEl.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const links = Array.from(resultsEl!.querySelectorAll('a.sd-item')) as HTMLAnchorElement[];
      if (!links.length) return;
      e.preventDefault();
      const idx = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = e.key === 'ArrowDown' ? Math.min(idx + 1, links.length - 1) : idx - 1;
      (next < 0 ? input : links[next])!.focus();
    });
  }
</script>
